#!/bin/bash
echo 0 > /sys/class/graphics/fbcon/cursor_blink
export DISPLAY=:0
APP_DIR=/aquabox
BIN_DIR=$APP_DIR/bin
LIB_DIR=$APP_DIR/lib
LOG_DIR=$APP_DIR/log
BAK_DIR=$APP_DIR/debug

mkdir -p $LOG_DIR
mkdir -p $BAK_DIR

rm -f $BAK_DIR/*
cp -r $LOG_DIR/* $BAK_DIR
rm -f $LOG_DIR/*

export LD_LIBRARY_PATH=$LIB_DIR
$BIN_DIR/aquabox --debug
return $$