            "setupCommands": [
                {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Launch Devices Manager",
            "type": "cppdbg",
            "request": "launch",
            "program": "/build/bin/ab_devices_manager",
            "cwd": "/build/bin",
