                }
            ]
        },
        {
            "name": "Launch Client",
            "type": "cppdbg",
            "request": "launch",
            "program": "/build/bin/ab_client",
            "cwd": "/build/bin",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
