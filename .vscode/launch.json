{
    "version": "0.2.0",
    "configurations": [

        {
            "type": "gdb",
            "request": "attach",
            "name": "Attach to gdbserver",
            "gdbpath": "/usr/bin/gdb-multiarch",
            "executable": "/build/bin/ab_devices_manager",
            "target": "192.168.1.228:4444",
            "remote": true,
            "cwd": "${workspaceRoot}",
            "valuesFormatting": "parseText",
            "autorun": [
                "monitor sleep 5000000"
            ]
        },
        {
            "name": "Launch Server",
            "type": "cppdbg",
            "request": "launch",
            "program": "/build/bin/aquabox-server",
            "cwd": "/build/bin",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Launch Setting Provider",
            "type": "cppdbg",
            "request": "launch",
            "program": "/build/bin/ab_settings_provider",
            "cwd": "/build/bin",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Launch Events Bus",
