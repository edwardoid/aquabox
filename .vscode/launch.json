{
    "version": "0.2.0",
    "configurations": [
    {
        "name": "(gdb) Pipe Launch",
        "type": "cppdbg",
        "request": "launch",
        "program": "/build/bin/aquabox",
        "cwd": "/build/bin",
        "args": [ "--nodraw", "--ignore-networking", "--ignore-lock"],
        "stopAtEntry": true,
        "environment": [],
        "externalConsole": true,
        "sourceFileMap": { "/sources": "${workspaceFolder}" },
        "pipeTransport": {
            "debuggerPath": "/usr/bin/gdb",
            "pipeProgram": "docker",
            "pipeArgs": ["exec", "-i", "430f82b29522", "sh", "-c"],
            "pipeCwd": "${workspaceRoot}"
        },
        "MIMode": "gdb",
        "setupCommands": [{
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
        }]
    }, ]
}