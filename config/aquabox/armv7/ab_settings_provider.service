[Unit]
Description=Aquabox Settings service.
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
Type=simple
Environment="LD_LIBRARY_PATH=${AQUABOX_RUN_PATH_LIB}"
WorkingDirectory=${AQUABOX_RUN_PATH_BIN}
ExecStart=${AQUABOX_RUN_PATH_BIN}/${PROJECT_NAME}
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
