[Unit]
Description=Aquabox systemd service.
After=network.target
Wants=network.target
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
Type=simple
Environment="LD_LIBRARY_PATH=/aquabox/lib"
Environment="DBUS_SYSTEM_BUS_ADDRESS=unix:path=/var/run/dbus/system_bus_socket"
WorkingDirectory=/aquabox/bin
ExecStart=/aquabox/bin/aquabox --service --ignore-lock --disable-access-point --ignore-networking
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
