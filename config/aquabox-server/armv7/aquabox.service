[Unit]
Description=Aquabox systemd service.
After=network.target
Wants=network.target
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
Type=simple
Environment="LD_LIBRARY_PATH=/aquabox/lib"
WorkingDirectory=/aquabox/bin
ExecStart=/aquabox/bin/aquabox-server
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
