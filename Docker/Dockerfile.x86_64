FROM ubuntu:18.04

ENV DEBIAN_FRONTEND noninteractive

LABEL maintainer="Edward Sargsyan <edward.sarkisyan@gmail.com>"

USER root

#RUN add-apt-repository universe

RUN apt-get update --fix-missing && \
    apt-get install -y software-properties-common \
    wget \
    libtool \
    intltool \
    autoconf \
    automake \
    automake-1.15 \
    pkg-config \
    make \
    tar \
    valgrind \
    vim \
    git \
    ssh \
    sshpass \
    python3-pip \
    python-pip

RUN apt-get purge -y cmake

RUN mkdir /var/run/sshd

# tools
RUN pip install conan --upgrade

RUN cd /opt && \
    wget -c https://github.com/Kitware/CMake/releases/download/v3.18.4/cmake-3.18.4-Linux-x86_64.sh && \
    chmod +x /opt/cmake-3.18.4-Linux-x86_64.sh && \
    bash /opt/cmake-3.18.4-Linux-x86_64.sh --skip-license --prefix=/usr/local/


ENV CC=gcc \
    CFLAGS=-pthread \
    CXXFLAGS=-pthread \
    LDFLAGS=-pthread \
    BUILD_PLATFORM=x86_64 \
    LD_LIBRARY_PATH=/build/lib

# tools
RUN conan profile new default --detect && \
    conan profile update settings.compiler.libcxx=libstdc++11 default && \
    conan profile update settings.build_type=Release default && \
    conan profile update settings.os=Linux default && \
    conan profile update settings.compiler.cppstd=14 default && \
    conan remote add iot https://api.bintray.com/conan/edwardoid/iot && \
    conan remote add bincrafters https://api.bintray.com/conan/bincrafters/public-conan && \
    conan remote add devcodeone https://api.bintray.com/conan/devcodeone/public-conan

RUN echo "export BUILD_PLATFORM=x86_64" >> /root/.profile && \
    echo "export CC=gcc" >> /root/.profile && \
    echo "export CFLAGS=-pthread" >> /root/.profile && \
    echo "export LDFLAGS=-pthread" >> /root/.profile && \
    echo "export LD_LIBRARY_PATH=/build/lib" >> /root/.profile && \
    echo "source $HOME/.bashrc"

RUN echo 'root:root' |chpasswd

RUN sed -ri 's/^#?PermitRootLogin\s+.*/PermitRootLogin yes/' /etc/ssh/sshd_config
RUN sed -ri 's/UsePAM yes/#UsePAM yes/g' /etc/ssh/sshd_config

RUN mkdir /root/.ssh

RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

EXPOSE 22

CMD    ["/usr/sbin/sshd", "-D"]
