FROM debian:stable

ENV DEBIAN_FRONTEND noninteractive

LABEL maintainer="Edward Sargsyan <edward.sarkisyan@gmail.com>"

USER root

RUN apt-get update --fix-missing && \
    apt-get install -y \
    wget libtool \
    intltool autoconf \
    automake automake-1.15 \
    pkg-config make \
    tar vim ssh \
    python3 python3-pip git sshpass tzdata

RUN wget -c https://github.com/Kitware/CMake/releases/download/v3.20.5/cmake-3.20.5-linux-x86_64.sh &&  \
    chmod +x cmake-3.20.5-linux-x86_64.sh && \
    ./cmake-3.20.5-linux-x86_64.sh --skip-license --prefix=/usr

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3 1 && \
    update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

RUN pip install conan --upgrade

RUN wget -c https://ipapi.co/timezone -O /timezone_info && \
    export TZ=$(cat /timezone_info) && \
    ln -sfn /usr/share/zoneinfo/$TZ /etc/timezone

RUN TOOLCHAIN="arm-linux-gnueabihf"; \
    MAJOR="7.5"; \
    MINOR="0"; \
    DATE="2019.12"; \
    ARCH="x86_64"; \
    ARCHIVE="gcc-linaro-${MAJOR}.${MINOR}-${DATE}-${ARCH}_${TOOLCHAIN}"; \
    MIRROR="https://releases.linaro.org/components/toolchain/binaries"; \
    wget -O - "${MIRROR}/${MAJOR}-${DATE}/${TOOLCHAIN}/${ARCHIVE}.tar.xz" | \
    tar -C /opt -xJf - && \
    mv /opt/${ARCHIVE} /opt/toolchain && \
    cp -a /opt/toolchain/${TOOLCHAIN}/libc/lib/* /opt/toolchain/${TOOLCHAIN}/lib

# sysroot
RUN ln -s /opt/toolchain/arm-linux-gnueabihf /opt/sysroot

ENV PATH="/opt/toolchain/bin:${PATH}" \
    CC=arm-linux-gnueabihf-gcc \
    CXX=arm-linux-gnueabihf-g++ \
    CMAKE_C_COMPILER=arm-linux-gnueabihf-gcc \
    CMAKE_CXX_COMPILER=arm-linux-gnueabihf-g++ \
    STRIP=arm-linux-gnueabihf-strip \
    RANLIB=arm-linux-gnueabihf-ranlib \
    LD=arm-linux-gnueabihf-ld \
    CFLAGS=-pthread \
    CXXFLAGS=-pthread \
    LDFLAGS=-pthread \
    BUILD_PLATFORM=armv7

RUN pip install pip --upgrade && \
    pip install conan --upgrade

# tools
RUN conan profile new default --detect && \
    conan profile update settings.compiler.libcxx=libstdc++11 default && \
    conan profile update settings.build_type=Release default && \
    conan profile update settings.os=Linux default && \
    conan profile update settings.arch=armv7hf default && \
    conan profile update settings.os_build=Linux default && \
    conan profile update settings.arch_build=x86_64 default && \
    conan profile update settings.compiler=gcc default && \
    conan profile update settings.compiler.version=7 default && \
    conan profile update settings.compiler.cppstd=14 default && \
    conan remote add bincrafters https://bincrafters.jfrog.io/artifactory/api/conan/public-conan && \
    conan remote add aquabox http://aquabox.me:9300 && \
    conan config set general.revisions_enabled=1

RUN echo "export PATH=/opt/pyenv/shims:/opt/pyenv/bin:/opt/toolchain/bin:$PATH" >> /root/.profile && \
    echo "export CC=arm-linux-gnueabihf-gcc" >> /root/.profile && \
    echo "export CXX=arm-linux-gnueabihf-g++" >> /root/.profile && \
    echo "export CMAKE_C_COMPILER=arm-linux-gnueabihf-gcc" >> /root/.profile && \ 
    echo "export CMAKE_CXX_COMPILER=arm-linux-gnueabihf-g++" >> /root/.profile && \
    echo "export STRIP=arm-linux-gnueabihf-strip" >> /root/.profile && \
    echo "export RANLIB=arm-linux-gnueabihf-ranlib" >> /root/.profile && \
    echo "export LD=arm-linux-gnueabihf-ld" >> /root/.profile && \
    echo "export AS=arm-linux-gnueabihf-as" >> /root/.profile && \
    echo "export AR=arm-linux-gnueabihf-ar" >> /root/.profile && \
    echo "export BUILD_PLATFORM=armv7" >> /root/.profile && \
    echo "source $HOME/.bashrc"



RUN mkdir /var/run/sshd

RUN echo 'root:root' |chpasswd

RUN sed -ri 's/^#?PermitRootLogin\s+.*/PermitRootLogin yes/' /etc/ssh/sshd_config
RUN sed -ri 's/UsePAM yes/#UsePAM yes/g' /etc/ssh/sshd_config

RUN mkdir /root/.ssh

RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

EXPOSE 22

CMD    ["/usr/sbin/sshd", "-D"]


