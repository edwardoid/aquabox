target_host=arm-linux-gnueabihf
standalone_toolchain=/usr/bin
cc_compiler=gcc-8
cxx_compiler=g++-8

[settings]
os_build=Linux
os=Linux
arch=armv7hf
compiler=gcc
compiler.version=8
compiler.libcxx=libstdc++11
build_type=Release

[buildenv]
# for conan v2 recipes as well
CHOST=$toolchain
CHOST=$target_host
AR=$target_host-ar
AS=$target_host-as
RANLIB=$target_host-ranlib
LD=$target_host-ld
STRIP=$target_host-strip
CC=$target_host-$cc_compiler
CXX=$target_host-$cxx_compiler

[env]
PATH=[/usr/bin/]
CHOST=$target_host
AR=$target_host-ar
AS=$target_host-as
RANLIB=$target_host-ranlib
LD=$target_host-ld
STRIP=$target_host-strip
CC=$target_host-$cc_compiler
CXX=$target_host-$cxx_compiler
CXXFLAGS=-I"$standalone_toolchain/$target_host/lib/include"