#target_host=arm-linux-gnueabihf
#standalone_toolchain=/toolchain/armv6/bin
#cc_compiler=gcc
#cxx_compiler=g++

[settings]
os=Linux
arch=armv6
compiler=gcc
compiler.version=12
#compiler.libcxx=libstdc++11
build_type=Release

[options]
libpng/*:neon=False

[buildenv]
# for conan v2 recipes as well
#PATH=[/toolchain/armv6/bin]
#CHOST=$toolchain
CXXFLAGS=-std=-m64 -D__INT64_TYPE__=long long -D__UINT64_TYPE__=unsigned long long
CHOST=arm-linux-gnueabihf
AR=arm-linux-gnueabihf-ar
AS=arm-linux-gnueabihf-as
RANLIB=arm-linux-gnueabihf-ranlib
LD=arm-linux-gnueabihf-ld
STRIP=arm-linux-gnueabihf-strip
CC=arm-linux-gnueabihf-gcc-12
CXX=arm-linux-gnueabihf-g++-12
